        </Reference>
        <Reference Include="SAM.Analytical.Tas.TPD">
          <HintPath>..\..\..\SAM_Tas\build\SAM.Analytical.Tas.TPD.dll</HintPath>
        </Reference>
        <Reference Include="SAM.Analytical.OCCT">
            <HintPath>..\..\..\SAM_OCCT\build\SAM.Analytical.OCCT.dll</HintPath>
        </Reference>
        <Reference Include="SAM.Core.OCCT">
            <HintPath>..\..\..\SAM_OCCT\build\SAM.Core.OCCT.dll</HintPath>
