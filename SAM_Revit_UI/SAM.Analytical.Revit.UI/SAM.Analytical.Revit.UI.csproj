        <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
        <PackageReference Include="NetOfficeFw.Excel" Version="1.9.7" />
        <PackageReference Include="NetTopologySuite" Version="2.6.0" />
        <PackageReference Include="System.Text.Json" Version="8.0.5" />
	  
        <Reference Include="RevitAPIUI">
            <HintPath>$(SolutionDir)\references\Revit $(RevitYear)\RevitAPIUI.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="RevitAPI">
            <HintPath>$(SolutionDir)\references\Revit $(RevitYear)\RevitAPI.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="RevitAPIIFC">
            <HintPath>$(SolutionDir)\references\Revit $(RevitYear)\RevitAPIIFC.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>
	
  <PropertyGroup>
    <PostBuildEvent>
      if "$(Configuration)" == "Debug2025" (
      set Version=Revit 2025
      )

      if "$(Configuration)" == "Debug2026" (
      set Version=Revit 2026
      )

      if "$(Configuration)" == "Debug2027" (
      set Version=Revit 2027
      )

      if "$(Configuration)" == "Release2025" (
      set Version=Revit 2025
      )

      if "$(Configuration)" == "Release2026" (
      set Version=Revit 2026
      )

      if "$(Configuration)" == "Release2027" (
      set Version=Revit 2027
      )

      ::A Revit-year configuration with no matching branch above would leave Version empty,
      ::collapsing SAM_DIR to %25APPDATA%25\SAM itself and scattering that year's assemblies
      ::loose into the shared Rhino/Grasshopper folder. Fail loudly instead - silently
      ::deploying net10 (2027) assemblies next to net8 ones is far worse than a build error.
      if "%25Version%25" == "" (
      echo POST-BUILD ERROR: no SAM_DIR mapping for configuration '$(Configuration)'. Add a 'set Version=Revit ^&lt;year^&gt;' branch above.
      exit /b 1
      )

      set SAM_DIR=$(APPDATA)\SAM\%25Version%25
      if not exist "%25SAM_DIR%25" mkdir "%25SAM_DIR%25"

      ::The native OCCT kernel is only present when SAM_OCCT built it (build-native.ps1).
      ::CI sets SAM_OCCT_SKIP_NATIVE_BUILD=true and builds the managed assemblies only, so
      ::every native copy below must be 'if exist' guarded or the post-build event fails.
      if exist "$(SolutionDir)..\SAM_OCCT\build\SAM.Occt.Native.dll" Copy /Y "$(SolutionDir)..\SAM_OCCT\build\SAM.Occt.Native.dll" "$(TargetDir)SAM.Occt.Native.dll"
      if exist "$(SolutionDir)..\SAM_OCCT\build\TK*.dll" Copy /Y "$(SolutionDir)..\SAM_OCCT\build\TK*.dll" "$(TargetDir)TK*.dll"
      if exist "$(SolutionDir)..\SAM_OCCT\build\tbb*.dll" Copy /Y "$(SolutionDir)..\SAM_OCCT\build\tbb*.dll" "$(TargetDir)tbb*.dll"
      if exist "$(SolutionDir)..\SAM_OCCT\build\freetype*.dll" Copy /Y "$(SolutionDir)..\SAM_OCCT\build\freetype*.dll" "$(TargetDir)freetype*.dll"
      if exist "$(SolutionDir)..\SAM_OCCT\build\FreeImage*.dll" Copy /Y "$(SolutionDir)..\SAM_OCCT\build\FreeImage*.dll" "$(TargetDir)FreeImage*.dll"
      if exist "$(SolutionDir)..\SAM_OCCT\build\jemalloc*.dll" Copy /Y "$(SolutionDir)..\SAM_OCCT\build\jemalloc*.dll" "$(TargetDir)jemalloc*.dll"
      if exist "$(SolutionDir)..\SAM_OCCT\build\av*.dll" Copy /Y "$(SolutionDir)..\SAM_OCCT\build\av*.dll" "$(TargetDir)av*.dll"
      if exist "$(SolutionDir)..\SAM_OCCT\build\swscale*.dll" Copy /Y "$(SolutionDir)..\SAM_OCCT\build\swscale*.dll" "$(TargetDir)swscale*.dll"
      if exist "$(SolutionDir)..\SAM_OCCT\build\openvr_api*.dll" Copy /Y "$(SolutionDir)..\SAM_OCCT\build\openvr_api*.dll" "$(TargetDir)openvr_api*.dll"
      if exist "$(SolutionDir)..\SAM_OCCT\build\zlib*.dll" Copy /Y "$(SolutionDir)..\SAM_OCCT\build\zlib*.dll" "$(TargetDir)zlib*.dll"
      if exist "$(SolutionDir)..\SAM_OCCT\build\msvcp140*.dll" Copy /Y "$(SolutionDir)..\SAM_OCCT\build\msvcp140*.dll" "$(TargetDir)msvcp140*.dll"
      if exist "$(SolutionDir)..\SAM_OCCT\build\vcruntime140*.dll" Copy /Y "$(SolutionDir)..\SAM_OCCT\build\vcruntime140*.dll" "$(TargetDir)vcruntime140*.dll"
      if exist "$(SolutionDir)..\SAM_OCCT\build\concrt140*.dll" Copy /Y "$(SolutionDir)..\SAM_OCCT\build\concrt140*.dll" "$(TargetDir)concrt140*.dll"

      if exist "$(TargetDir)SAM.Analytical.Topologic.dll" del /Q "$(TargetDir)SAM.Analytical.Topologic.dll"
      if exist "$(TargetDir)SAM.Core.Topologic.dll" del /Q "$(TargetDir)SAM.Core.Topologic.dll"
      if exist "$(TargetDir)SAM.Geometry.Topologic.dll" del /Q "$(TargetDir)SAM.Geometry.Topologic.dll"
      if exist "$(TargetDir)TopologicCore.dll" del /Q "$(TargetDir)TopologicCore.dll"
      if exist "$(TargetDir)TopologicNET.dll" del /Q "$(TargetDir)TopologicNET.dll"

      copy "$(TargetDir)*.dll" "%25SAM_DIR%25"
      if exist "%25SAM_DIR%25\SAM.Analytical.Topologic.dll" del /Q "%25SAM_DIR%25\SAM.Analytical.Topologic.dll"
      if exist "%25SAM_DIR%25\SAM.Core.Topologic.dll" del /Q "%25SAM_DIR%25\SAM.Core.Topologic.dll"
      if exist "%25SAM_DIR%25\SAM.Geometry.Topologic.dll" del /Q "%25SAM_DIR%25\SAM.Geometry.Topologic.dll"
      if exist "%25SAM_DIR%25\TopologicCore.dll" del /Q "%25SAM_DIR%25\TopologicCore.dll"
      if exist "%25SAM_DIR%25\TopologicNET.dll" del /Q "%25SAM_DIR%25\TopologicNET.dll"
      ::copy "$(TargetDir)*.exe" "%25SAM_DIR%25"</PostBuildEvent>
  </PropertyGroup>
</Project>
